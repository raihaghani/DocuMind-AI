# ---------------------------------------------------------------------------
# DocuMind AI - environment configuration
# Copy this file to `.env` and adjust values. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# Django core
# Generate a new one with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database
# Leave DATABASE_URL empty to use the bundled SQLite database (development default).
# For PostgreSQL (production), e.g.:
#   DATABASE_URL=postgres://user:password@localhost:5432/documind
DATABASE_URL=

# Timezone used for daily usage-quota resets and timestamps.
DJANGO_TIME_ZONE=UTC

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# AI_PROVIDER selects the answer backend: "mock" (default, no credentials
# required) or "openai" (requires AI_API_KEY).
AI_PROVIDER=mock

# Credentials / configuration used only when AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_REQUEST_TIMEOUT=30

# ---------------------------------------------------------------------------
# Application limits (all optional - sensible defaults applied in settings.py)
# ---------------------------------------------------------------------------
# Max upload size in megabytes.
MAX_UPLOAD_SIZE_MB=10
# AI questions allowed per user per day.
DAILY_QUESTION_LIMIT=10
# Minimum TF-IDF cosine similarity for a chunk to count as supporting evidence.
RETRIEVAL_MIN_SCORE=0.05
# Number of top chunks forwarded to the answer provider.
RETRIEVAL_TOP_K=3
